# 复制为 .env（install-docker.sh 会自动生成并随机设置密码）
# 创建空间时需要的服务器密码（只在第一台设备创建空间时输入一次）
PASSWORD=change-me-to-a-long-random-string

# 本机监听地址和端口。宿主机上的 cloudflared 指向 http://127.0.0.1:8090
BIND_HOST=127.0.0.1
HOST_PORT=8090

# 可选：Cloudflare Zero Trust 里创建 Tunnel 得到的 token。
# 填了之后 install-docker.sh 会顺带启动 cloudflared 容器，Public Hostname 指向 http://copyanywhere:8080
TUNNEL_TOKEN=

# 内容保存时长（小时），到期自动删除
TTL_HOURS=24
# 整台 VPS 上所有空间合计的存储上限（MB），满了自动删除最旧的内容。5120 = 5GB
MAX_TOTAL_MB=5120
# 单个文件上限（MB），默认等于总上限。大文件会自动分块上传，不受 Cloudflare 100MB 限制
# MAX_FILE_MB=5120
# 每个空间最多保留的条数
MAX_ITEMS=500
# 磁盘至少留出的空闲空间（MB），不够时拒绝上传
MIN_FREE_MB=512
