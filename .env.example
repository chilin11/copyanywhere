# 复制为 .env（install.sh 会自动生成并随机设置密码）
# 创建空间时需要的服务器密码（只在第一台设备创建空间时输入一次）
PASSWORD=change-me-to-a-long-random-string
# 本机监听端口（反代指向 http://127.0.0.1:8090）
HOST_PORT=8090
# 内容保存时长（小时），到期自动删除
TTL_HOURS=24
# 单个文件上限（MB）。走 Cloudflare 代理 / Tunnel 时请保持 <= 95（免费版请求体上限 100MB）
MAX_FILE_MB=90
# 每个空间的总容量上限（MB）和条数上限，超出时自动删除最旧的内容
MAX_SPACE_MB=1024
MAX_ITEMS=200
